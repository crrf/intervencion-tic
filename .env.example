# ---------------------------------------------------------------------------
# Sistema de Tickets e Incidencias - Intervencion Tecnica
# Copiar a .env y CAMBIAR TODOS LOS SECRETOS antes de usar en produccion.
# ---------------------------------------------------------------------------

# --- Aplicacion ---------------------------------------------------------
FLASK_ENV=production
SECRET_KEY=cambiar-esta-clave-por-una-aleatoria-de-al-menos-32-caracteres
APP_TZ=UTC
LOG_LEVEL=INFO

# --- Persistencia en el host --------------------------------------------
# Directorio del ANFITRION donde viven los datos de PostgreSQL y de Garage.
# Puede ser relativo al proyecto o una ruta absoluta (p. ej. /srv/tickets/datos).
RUTA_DATOS=./datos

# --- PostgreSQL ---------------------------------------------------------
POSTGRES_USER=tickets
POSTGRES_PASSWORD=tickets_dev_password
POSTGRES_DB=tickets
DATABASE_URL=postgresql+psycopg://tickets:tickets_dev_password@db:5432/tickets

# --- Garage / S3 --------------------------------------------------------
# El rpc_secret debe ser exactamente 64 caracteres hexadecimales.
GARAGE_RPC_SECRET=4f8b2c9d1e7a3560bf42d8e01c9a75b6382ef04d5a1c7b93e6208fd4ac513762
GARAGE_ADMIN_TOKEN=cambiar-token-admin-de-garage
GARAGE_ZONE=dc1
GARAGE_CAPACITY=10GB

# El access key DEBE tener el formato GK + 24 hexadecimales (26 caracteres).
# El secret key DEBE ser 64 caracteres hexadecimales. Garage rechaza otros formatos.
S3_ACCESS_KEY=GK7f3a91c05de248b6a1e07c34
S3_SECRET_KEY=9d41ba7e06c8f523ad10e9b7c6482f3105da97be2c40817fe3b95d602ac7148e
S3_BUCKET=tickets-adjuntos
S3_REGION=garage

# Endpoint INTERNO: lo usa el contenedor de Flask para subir objetos.
S3_ENDPOINT_URL=http://garage:3900
# Endpoint PUBLICO: se usa SOLO para firmar las URL que abre el navegador.
# Si esto apunta a http://garage:3900 las imagenes NO cargaran en el navegador.
S3_PUBLIC_ENDPOINT=http://localhost:3900
S3_URL_EXPIRACION=900

# --- Fotos --------------------------------------------------------------
MAX_FOTO_MB=8
FOTO_MAX_PIXELES=1920

# --- Arranque -----------------------------------------------------------
# CREAR_ADMIN: crea SOLO la cuenta de administrador. Es lo que corresponde en
#              produccion; el resto de los usuarios los crea el admin desde la
#              aplicacion. Lo activa desplegar.sh.
# SEED_ON_START: siembra usuarios y tickets de ejemplo. Solo para demostracion
#                o desarrollo. NUNCA en produccion.
CREAR_ADMIN=false
ADMIN_FORZAR_CAMBIO=
SEED_ON_START=true

ADMIN_USUARIO=admin
ADMIN_PASSWORD=Admin.2026
ADMIN_NOMBRE=Administrador del Sistema
ADMIN_EMAIL=admin@intervencion.local
SEED_PASSWORD=Clave.2026

# Ponlo en true si la aplicacion queda detras de HTTPS.
SESSION_COOKIE_SECURE=false
